# Frontend — Local Development
# Vite auto-loads this file when running `npm run dev` or `npm start`
#
# Since we route both frontend and backend through Caddy on localhost,
# the API URL is relative to the current domain (/api/).
VITE_API_URL=/api/

# To run Vite directly without Caddy (e.g. at http://localhost:5173):
# VITE_API_URL=http://localhost:5000/api/
