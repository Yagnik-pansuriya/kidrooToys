# Frontend — Production Build
# Vite bakes this into the bundle at build time (`npm run build`)
#
# ── For VPS / Caddy deployment (kidrootoys.co) ──
# Since both frontend and backend are hosted on the same domain under Caddy,
# we can use a relative path (/api/).
VITE_API_URL=/api/

# ── For Vercel deployment (pre-production) ──
# If you deploy to Vercel, the frontend and backend run on separate domains.
# You MUST override VITE_API_URL in the Vercel Dashboard -> Project Settings -> Environment Variables
# Example Value: https://kidroo-backend.vercel.app/api/
