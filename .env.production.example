# ══════════════════════════════════════════════════════════════════════════════
# .env.production.example — Production Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
#   1. Copy this file to `kidrooBackend/.env` on your VPS
#   2. Fill in ALL values marked with <...>
#   3. Generate secure secrets (don't use the examples!)
#
# Generate a JWT secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# ══════════════════════════════════════════════════════════════════════════════

# === APPLICATION ===
NODE_ENV=production
PORT=5000

# === DATABASE ===
DB_URL=<your-mongodb-atlas-connection-string>

# === SECURITY ===
# Comma-separated allowed origins (your frontend domain)
ALLOWED_ORIGINS=https://kidroo.in,https://www.kidroo.in

# === JWT ===
JWT_SECRET=<generate-a-64-char-hex-secret>
JWT_EXPIRE=7d

# === CLOUDINARY ===
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# === REDIS ===
# When using the Docker Compose stack, Redis is at redis://redis:6379
# The docker-compose.prod.yml sets this automatically, but you can override here
# REDIS_URL=redis://redis:6379

# === SMS PROVIDER ===
SMS_PROVIDER=twilio

# === TWILIO ===
TWILIO_ACCOUNT_SID=<your-twilio-sid>
TWILIO_AUTH_TOKEN=<your-twilio-token>
TWILIO_PHONE_NUMBER=<your-twilio-number>

# === MSG91 (Alternative SMS) ===
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=KIDROO
# MSG91_ROUTE=4
# MSG91_COUNTRY=91
# MSG91_TEMPLATE_ID=
# MSG91_ENTITY_ID=

# === MSG91 WhatsApp ===
# MSG91_WA_TEMPLATE_ORDER_CONFIRMED=kidroo_order_confirmed
# MSG91_WA_TEMPLATE_ORDER_STATUS=kidroo_order_status

# === OPTIONAL ===
LOG_LEVEL=warn
REQUEST_TIMEOUT=30000
