# ══════════════════════════════════════════════════════════════════════════════
# Caddyfile — Reverse Proxy Configuration for KidrooToys (Single-Domain Setup)
# ══════════════════════════════════════════════════════════════════════════════
#
# Caddy automatically handles:
#   ✓ Let's Encrypt SSL certificates (auto-HTTPS)
#   ✓ Certificate renewal
#   ✓ HTTP → HTTPS redirect
#   ✓ TLS termination
#   ✓ HTTP/2 and HTTP/3
#
# INSTRUCTIONS:
#   1. Replace "your-email@example.com" with your email (for Let's Encrypt warnings)
#   2. Make sure your DNS A records point to your VPS IP address for kidrootoys.co
#
# ══════════════════════════════════════════════════════════════════════════════

{
    # Email for Let's Encrypt certificate registration
    email your-email@example.com
}

kidrootoys.co, www.kidrootoys.co {
    # Compression
    encode gzip zstd

    # Route API requests to backend container
    handle /api/* {
        reverse_proxy backend:5000
    }

    # Route Swagger Docs to backend container
    handle /docs* {
        reverse_proxy backend:5000
    }

    # Route Health Check to backend container
    handle /health {
        reverse_proxy backend:5000
    }

    # Route all other routes to Nginx serving static frontend
    handle {
        reverse_proxy frontend:80
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Remove server identity header for security
        -Server
    }

    # Logging
    log {
        output file /data/logs/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
